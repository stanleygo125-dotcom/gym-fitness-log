<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Workout | Workout Logger</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">

    <%- include('partial/navbar') %>

    <main class="container mt-5">

        <div class="row justify-content-center">

            <div class="col-md-6">

                <div class="card shadow-sm">

                    <div class="card-body p-4">

                        <h1 class="text-center mb-4">
                            Add Workout
                        </h1>

                        <% if (errorMessage.length > 0) { %>

                            <div class="alert alert-danger">
                                <%= errorMessage[0] %>
                            </div>

                        <% } %>

                       

                        <form action="/addWorkout" method="POST">

                            <div class="mb-3">

                                <label for="exercise_name" class="form-label">
                                    Exercise Name
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="exercise_name"
                                    name="exercise_name"
                                    value="<%= formData.exercise_name || '' %>"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label for="sets" class="form-label">
                                    Sets
                                </label>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="sets"
                                    name="sets"
                                    value="<%= formData.sets || '' %>"
                                    min="1"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label for="repetitions" class="form-label">
                                    Repetitions
                                </label>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="repetitions"
                                    name="repetitions"
                                    value="<%= formData.repetitions || '' %>"
                                    min="1"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label for="weight" class="form-label">
                                    Weight (kg)
                                </label>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="weight"
                                    name="weight"
                                    value="<%= formData.weight || '' %>"
                                    min="0"
                                    step="0.1"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label for="duration" class="form-label">
                                    Duration (minutes)
                                </label>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="duration"
                                    name="duration"
                                    value="<%= formData.duration || '' %>"
                                    min="1"
                                    required
                                >

                            </div>

                            <div class="mb-3">

                                <label for="workout_date" class="form-label">
                                    Workout Date
                                </label>

                                <input
                                    type="date"
                                    class="form-control"
                                    id="workout_date"
                                    name="workout_date"
                                    value="<%= formData.workout_date || '' %>"
                                    required
                                >

                            </div>

                            <div class="d-flex gap-2">

                                <button
                                    type="submit"
                                    class="btn btn-primary w-100"
                                >
                                    Add Workout
                                </button>

                                <a
                                    href="/workoutshistory"
                                    class="btn btn-secondary w-100"
                                >
                                    Cancel
                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </main>

</body>

</html>