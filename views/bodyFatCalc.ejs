<!DOCTYPE html>
<html lang="en">
<head>
      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Body Fat Result</title>

          <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
      <%- include('partial/navbar') %>

      <div class="container py-5">
            <div class="card shadow">
                  <div class="card-header bg-success text-white">
                        <h3 class="mb-0">Body Fat Result</h3>
                  </div>


                  <div class="card-body">
                        <table class="table table-bordered">
                              <tr>
                                    <th>Gender</th>
                                    <td><%= gender %></td>
                              </tr>
                              <tr>
                                    <th>Age</th>
                                    <td><%= age %> years old</td>
                              </tr>
                              <tr>
                                    <th>Weight</th>
                                    <td><%= weight %> kg</td>
                              </tr>
                              <tr>
                                    <th>Height</th>
                                    <td><%= height %> m</td>
                              </tr>
                              <tr>
                                    <th>BMI</th>
                                    <td><%= bmi %></td>
                              </tr>
                              <tr>
                                    <th>Estimated Body Fat</th>
                                    <td>
                                          <strong>
                                                <%= body_fat %> %
                                          </strong>
                                    </td>
                              </tr>
                        </table>

                        <% let category = "";
                        if (body_fat < 10){
                              category = "Very Lean";
                        }else if(body_fat < 20){
                              category = "Healthy";
                        }else if(body_fat < 25){
                              category = "Average";
                        }else{
                              category = "High";
                        } %>


                        <div class="alert alert-info">
                              <strong>Body Fat Category:</strong>
                              <%= category %>
                        </div>
                        
                        <a href="/bodyFat" class="btn btn-primary">Calculate Again</a>
                        <a href="/bodyProgress" class="btn btn-secondary">Back to Tracker</a>
                  </div>
            </div>
      </div>

</body>

</html>