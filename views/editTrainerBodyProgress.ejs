<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Body Progress Record</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <%- include('partial/navbar') %>

    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h3>Edit Body Progress Record</h3>
            </div>
            <div class="card-body">
                <form action="/trainer/editBodyProgress/<%= record.bp_id %>" method="POST">
                    <div class="mb-3">
                        <label class="form-label">Trainee Username</label>
                        <input
                            type="text"
                            class="form-control"
                            value="<%= record.username %>"
                            readonly>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Body Weight (kg)</label>
                        <input
                            type="number"
                            step="0.01"
                            class="form-control"
                            name="weight"
                            value="<%= record.weight %>"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">BMI</label>
                        <input
                            type="number"
                            step="0.01"
                            class="form-control"
                            name="bmi"
                            value="<%= record.bmi %>"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Body Fat (%)</label>
                        <input
                            type="number"
                            step="0.01"
                            class="form-control"
                            name="body_fat"
                            value="<%= record.body_fat %>"
                            required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Progress Date</label>
                        <input
                            type="date"
                            class="form-control"
                            name="progress_date"
                            value="<%= record.progress_date ? new Date(record.progress_date).toLocaleDateString('sv-SE') : '' %>"
                            required>
                    </div>

                    <button type="submit" class="btn btn-success">Update Record</button>
                    <a href="/trainer/bodyProgress" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
