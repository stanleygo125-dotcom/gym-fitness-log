<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Workout</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<%- include('partial/navbar') %>

<div class="container mt-5">

    <div class="card shadow">

        <div class="card-header bg-warning">

            <h3>Edit Workout</h3>

        </div>

        <div class="card-body">

            <form action="/trainer/editWorkout/<%= workout.workout_id %>" method="POST">

                <div class="mb-3">

                    <label class="form-label">
                        Username
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        value="<%= workout.username %>"
                        readonly>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Exercise
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="exercise_name"
                        value="<%= workout.exercise_name %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Sets
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        name="sets"
                        value="<%= workout.sets %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Repetitions
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        name="repetitions"
                        value="<%= workout.repetitions %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Weight (kg)
                    </label>

                    <input
                        type="number"
                        step="0.1"
                        class="form-control"
                        name="weight"
                        value="<%= workout.weight %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Duration (minutes)
                    </label>

                    <input
                        type="number"
                        class="form-control"
                        name="duration"
                        value="<%= workout.duration %>"
                        required>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Workout Date
                    </label>

                    <input
                        type="date"
                        class="form-control"
                        name="workout_date"
                        value="<%= new Date(workout.workout_date).toLocaleDateString('sv-SE') %>"
                        required>

                </div>

                <button
                    type="submit"
                    class="btn btn-success">

                    Update Workout

                </button>

                <a
                    href="/trainer/workouts"
                    class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

</body>

</html>