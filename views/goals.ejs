<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Goals | Workout Logger</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .goal-card-header {
            background-color: rgba(255, 255, 255, 0.02) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        .goal-table-card .table tbody tr:hover {
            background-color: rgba(255, 255, 255, 0.02) !important;
        }

        .goal-actions-cell {
            min-width: 160px;
        }

        .goal-progress-cell {
            min-width: 240px;
        }

        .table th,
        .table td {
            padding: 0.7rem 0.75rem;
            vertical-align: middle;
        }

        @media (max-width: 767px) {
            .goal-progress-cell,
            .goal-actions-cell {
                min-width: auto;
            }
        }
    </style>
</head>

<body>

    <%- include('partial/navbar') %>

    <main class="container py-4 py-md-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-info text-white">🎯 Goals</span>
                    <h1 class="h2 mb-0">Goals</h1>
                </div>
                <p class="text-muted mb-0">Track your targets, progress, and completion status.</p>
            </div>
            <a href="/addGoal" class="btn btn-primary">Add Goal</a>
        </div>

        <% function formatDateISO(d) { if (!d) return '-'; try { return new Date(d).toLocaleDateString('en-GB',{day:'2-digit', month:'short', year:'numeric'}); } catch(e) { return '-'; } } %>

        <%# =========================
            Isaac - Goals
            ========================= %>

        <section class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 mb-1">Goal Overview</h2>
                        <p class="text-muted mb-0">A quick summary of your active and completed goals.</p>
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">
                    <div class="col">
                        <div class="card h-100 border-primary shadow-sm">
                            <div class="card-body d-flex flex-column p-4">
                                <h6 class="card-title text-muted mb-3">Total Goals</h6>
                                <p class="display-6 mb-0 mt-auto"><%= goalsSummary ? goalsSummary.totalGoals : 0 %></p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-success shadow-sm">
                            <div class="card-body d-flex flex-column p-4">
                                <h6 class="card-title text-muted mb-3">Goals Achieved</h6>
                                <p class="display-6 mb-0 mt-auto"><%= goalsSummary ? goalsSummary.goalsAchieved : 0 %></p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-warning shadow-sm">
                            <div class="card-body d-flex flex-column p-4">
                                <h6 class="card-title text-muted mb-3">In Progress</h6>
                                <p class="display-6 mb-0 mt-auto"><%= goalsSummary ? goalsSummary.goalsInProgress : 0 %></p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-info shadow-sm">
                            <div class="card-body d-flex flex-column p-4">
                                <h6 class="card-title text-muted mb-3">Completion Rate</h6>
                                <p class="display-6 mb-0 mt-auto"><%= goalsSummary ? goalsSummary.completionRate : 0 %>%</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length > 0) { %>
            <div class="alert alert-success" role="alert"><%= successMessage[0] %></div>
        <% } %>

        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length > 0) { %>
            <div class="alert alert-danger" role="alert"><%= errorMessage[0] %></div>
        <% } %>

        <% if (!goals || goals.length === 0) { %>
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm text-center py-4">
                        <div class="card-body">
                            <h5 class="card-title">No goals yet</h5>
                            <p class="card-text text-muted">No goals yet. Click <strong>Add Goal</strong> to create your first objective.</p>
                            <a href="/addGoal" class="btn btn-primary btn-lg">Add Goal</a>
                        </div>
                    </div>
                </div>
            </div>
        <% } else { %>
            <section class="card goals-table-card shadow-sm border-0">
                <div class="card-header goal-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">Goal Progress</h5>
                        <p class="text-muted mb-0 small">Monitor goals with target weight, progress, and completion status.</p>
                    </div>
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text">Search</span>
                        <input
                            id="goalsSearchInput"
                            type="text"
                            class="form-control"
                            placeholder="Exercise name"
                        >
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Exercise</th>
                                    <th class="text-end">Target Weight</th>
                                    <th class="text-end">Current PB</th>
                                    <th class="text-center">Progress</th>
                                    <th class="text-center">Target Date</th>
                                    <th class="text-center">Remaining</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="goalsTableBody">
                                <% goals.forEach(goal => { %>
                                    <% const curVal = typeof goal.currentPB !== 'undefined' ? Number(goal.currentPB) : 0; %>
                                    <% const tgtVal = goal.target_weight ? Number(goal.target_weight) : 0; %>
                                    <% const pctVal = tgtVal > 0 ? Math.min(100, Math.round((curVal / tgtVal) * 100)) : 0; %>
                                    <% const progressBarColor = pctVal === 100 ? '#198754' : (pctVal > 75 ? '#0d6efd' : (pctVal > 0 ? '#ffc107' : '#ffffff')); %>
                                    <tr data-exercise="<%= goal.exercise_name %>">
                                        <td style="min-width: 220px;">
                                            <div class="d-flex flex-column">
                                                <strong class="mb-1"><%= goal.exercise_name %></strong>
                                                <div class="text-muted small"><%= goal.notes %></div>
                                            </div>
                                        </td>
                                        <td class="text-end align-middle" style="width:120px;"><%= tgtVal %> kg</td>
                                        <td class="text-end align-middle" style="width:120px;"><%= curVal %> kg</td>
                                        <td class="align-middle" style="min-width:220px;">
                                            <div class="d-flex flex-column align-items-center goal-progress-cell">
                                                <div class="small mb-2 text-muted w-100 text-center">
                                                    <%= curVal %> kg / <%= tgtVal %> kg (<%= pctVal %>%)
                                                </div>
                                                <div class="progress rounded-pill w-100" style="height: 20px;">
                                                    <div class="progress-bar goal-progress-bar" role="progressbar" data-progress="<%= pctVal %>" data-color="<%= progressBarColor %>" aria-valuenow="<%= pctVal %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle" style="width:140px;"><%= formatDateISO(goal.target_date) %></td>
                                        <td class="text-center align-middle" style="width:120px;"><%= typeof goal.remaining !== 'undefined' ? (goal.remaining + ' kg') : '-' %></td>
                                        <td class="text-center align-middle" style="width:140px;">
                                            <div class="d-flex justify-content-center">
                                                <% if (goal.achieved) { %>
                                                    <span class="badge rounded-pill bg-success px-2 py-1">Completed</span>
                                                <% } else if (goal.target_date && new Date(goal.target_date) < new Date()) { %>
                                                    <span class="badge rounded-pill bg-danger px-2 py-1">Overdue</span>
                                                <% } else { %>
                                                    <span class="badge rounded-pill bg-warning text-dark px-2 py-1">In Progress</span>
                                                <% } %>
                                            </div>
                                        </td>
                                        <td class="text-center align-middle goal-actions-cell">
                                            <div class="d-flex justify-content-center gap-2 align-items-stretch">
                                                <a href="/editGoal/<%= goal.id %>" class="btn btn-warning btn-sm px-3 py-1 d-flex align-items-center justify-content-center">Edit</a>
                                                <form action="/deleteGoal/<%= goal.id %>" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-danger btn-sm px-3 py-1 d-flex align-items-center justify-content-center">Delete</button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        <% } %>

        <%# =========================
            Goals - END
            ========================= %>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.goal-progress-bar').forEach(function (bar) {
                const pct = Number(bar.dataset.progress || 0);
                bar.style.width = pct + '%';
                bar.style.backgroundColor = bar.dataset.color || '#ffffff';
            });
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/personalBest.js"></script>
</body>

</html>