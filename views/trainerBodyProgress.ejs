<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trainer Trainee Body Progress</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <%- include('partial/navbar') %>

    <% if (successMessage && successMessage.length > 0) { %>
        <div class="container mt-3">
            <div class="alert alert-success">
                <%= successMessage[0] %>
            </div>
        </div>
    <% } %>

    <% if (errorMessage && errorMessage.length > 0) { %>
        <div class="container mt-3">
            <div class="alert alert-danger">
                <%= errorMessage[0] %>
            </div>
        </div>
    <% } %>

    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="mb-1">Trainee Body Progress Management</h3>
                    <p class="mb-0">Manage every trainee's body progress records.</p>
                </div>
                <a href="/trainer" class="btn btn-light btn-sm">Back to Dashboard</a>
            </div>

            <div class="card-body">
                <div class="mb-3">
                    <div class="input-group">
                        <input
                            type="text"
                            id="searchInput"
                            class="form-control"
                            placeholder="Search username or BMI classification..."
                        >
                        <button class="btn btn-outline-primary" type="button" id="searchButton">Search</button>
                        <button class="btn btn-outline-secondary" type="button" id="resetButton">Reset</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="progressTable">
                        <thead class="table-dark">
                            <tr>
                                <th>User</th>
                                <th>Weight</th>
                                <th>BMI</th>
                                <th>Body Fat</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% progress.forEach(record => { %>
                                <tr>
                                    <td><%= record.username %></td>
                                    <td><%= record.weight %> kg</td>
                                    <td>
                                        <%= record.bmi %>
                                        <% if(record.bmi < 18.5){ %>
                                            <span class="badge bg-warning text-dark ms-2">Underweight</span>
                                        <% } else if(record.bmi < 25){ %>
                                            <span class="badge bg-success ms-2">Healthy</span>
                                        <% } else if(record.bmi < 30){ %>
                                            <span class="badge bg-warning text-dark ms-2">Overweight</span>
                                        <% } else { %>
                                            <span class="badge bg-danger ms-2">Obese</span>
                                        <% } %>
                                    </td>
                                    <td><%= record.body_fat %> %</td>
                                    <td><%= new Date(record.progress_date).toLocaleDateString() %></td>
                                    <td>
                                        <a href="/trainer/editBodyProgress/<%= record.bp_id %>" class="btn btn-warning btn-sm">Edit</a>
                                        <form action="/trainer/deleteBodyProgress/<%= record.bp_id %>" method="POST" class="d-inline">
                                            <button class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this body progress record?');">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                            <% if (progress.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted">No body progress records found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const searchInput = document.getElementById("searchInput");
        const searchButton = document.getElementById("searchButton");
        const resetButton = document.getElementById("resetButton");

        function filterProgress() {
            const filter = (searchInput?.value || "").toLowerCase().trim();
            const rows = document.querySelectorAll("#progressTable tbody tr");

            rows.forEach((row) => {
                if (row.cells.length < 6) return;
                const username = row.cells[0]?.textContent || "";
                const bmiText = row.cells[2]?.textContent || "";
                const matches = username.toLowerCase().includes(filter) || bmiText.toLowerCase().includes(filter);

                row.style.display = filter === "" || matches ? "" : "none";
            });
        }

        function resetFilters() {
            if (searchInput) {
                searchInput.value = "";
            }
            filterProgress();
        }

        if (searchInput) {
            searchInput.addEventListener("keyup", (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    filterProgress();
                } else {
                    filterProgress();
                }
            });
        }

        if (searchButton) {
            searchButton.addEventListener("click", filterProgress);
        }

        if (resetButton) {
            resetButton.addEventListener("click", resetFilters);
        }
    </script>
</body>
</html>
