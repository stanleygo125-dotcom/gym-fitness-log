<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Trainer Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

    <%- include('partial/navbar') %>

    <div class="container mt-5">

        <div class="card shadow">

            <div class="card-body">

                <h2 class="text-center mb-4">
                    🏋️ Personal Trainer Dashboard
                </h2>

                <h5 class="text-center mb-4">
                    Welcome,
                    <strong><%= user.username %></strong>
                </h5>

                <div class="row">

                    <div class="col-md-12 mb-3">

                        <div class="card text-center shadow-sm">

                            <div class="card-body">

                                <h4>📋</h4>

                                <h5>Manage Workouts</h5>

                                <p>
                                    View, edit and delete any user's workout.
                                </p>

                                <a
                                href="/trainer/workouts"
                                class="btn btn-primary">

                                    View Workouts

                                </a>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-12 mb-3">

                        <div class="card text-center shadow-sm">

                            <div class="card-body">

                                <h4>📈</h4>

                                <h5>Manage Trainees body progress</h5>

                                <p>
                                    View, edit and delete any trainee's body progress record.
                                </p>

                                <a
                                href="/trainer/bodyProgress"
                                class="btn btn-primary">

                                    View Body Progress

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>