<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width, initial-scale=1.0">

<title>

Trainer Workouts

</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

</head>

<body class="bg-light">

<%- include('partial/navbar') %>
<% if (successMessage && successMessage.length > 0) { %>

<div class="container mt-3">

<div class="alert alert-success">

<%= successMessage[0] %>

</div>

</div>

<% } %>

<div class="container mt-5">

<div class="card shadow">

<div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

<div>

<h3 class="mb-1">

Workout Management

</h3>

<p class="mb-0">

Manage every user's workouts.

</p>

</div>

<a href="/trainer" class="btn btn-light btn-sm">

Back to Dashboard

</a>

</div>

<div class="card-body">

<div class="mb-3">

<div class="input-group">

<input

type="text"

id="searchInput"

class="form-control"

placeholder="Search username or exercise..."

>

<button class="btn btn-outline-primary" type="button" id="searchButton">

Search

</button>

<button class="btn btn-outline-secondary" type="button" id="resetButton">

Reset

</button>

</div>

</div>

<div class="table-responsive">

<table
class="table table-bordered table-hover"
id="workoutTable">

<thead class="table-dark">

<tr>

<th>User</th>

<th>Exercise</th>

<th>Sets</th>

<th>Reps</th>

<th>Weight</th>

<th>Duration</th>

<th>Date</th>

<th>Actions</th>

</tr>

</thead>

<tbody>

<% workouts.forEach(workout=>{ %>

<tr>

<td>

<%= workout.username %>

</td>

<td>

<%= workout.exercise_name %>

</td>

<td>

<%= workout.sets %>

</td>

<td>

<%= workout.repetitions %>

</td>

<td>

<%= workout.weight %> kg

</td>

<td>

<%= workout.duration %> mins

</td>

<td>

<%= new Date(workout.workout_date).toLocaleDateString() %>

</td>

<td>

<a

href="/trainer/editWorkout/<%= workout.workout_id %>"

class="btn btn-warning btn-sm">

Edit

</a>

<form

action="/trainer/deleteWorkout/<%= workout.workout_id %>"

method="POST"

class="d-inline">

<button
    class="btn btn-danger btn-sm"
    onclick="return confirm('Are you sure you want to delete this workout?');">

    Delete

</button>

</form>

</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>

</div>

</div>

<script>

const searchInput = document.getElementById("searchInput");
const searchButton = document.getElementById("searchButton");
const resetButton = document.getElementById("resetButton");

function filterWorkouts() {

    const filter = (searchInput?.value || "").toLowerCase().trim();
    const rows = document.querySelectorAll("#workoutTable tbody tr");

    rows.forEach((row) => {

        const username = row.cells[0]?.textContent || "";
        const exercise = row.cells[1]?.textContent || "";
        const matches = username.toLowerCase().includes(filter) || exercise.toLowerCase().includes(filter);

        row.style.display = filter === "" || matches ? "" : "none";

    });

}

function resetFilters() {

    if (searchInput) {

        searchInput.value = "";

    }

    filterWorkouts();

}

if (searchInput) {

    searchInput.addEventListener("keyup", (event) => {

        if (event.key === "Enter") {

            event.preventDefault();
            filterWorkouts();

        } else {

            filterWorkouts();

        }

    });

}

if (searchButton) {

    searchButton.addEventListener("click", filterWorkouts);

}

if (resetButton) {

    resetButton.addEventListener("click", resetFilters);

}

</script>

</body>

</html>