<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Workout History</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partial/navbar') %>

    <main class="container py-4 py-md-5">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
            <div>
                <h1 class="h2 mb-1">Workout History</h1>
                <p class="text-muted mb-0">
                    Welcome, <%= user.username %> — review your progress and personal bests.
                </p>
            </div>
            <a href="/addWorkout" class="btn btn-primary">Add Workout</a>
        </div>

        <% if (typeof successMessage !== 'undefined' && successMessage && successMessage.length > 0) { %>
            <div class="alert alert-success" role="alert">
                <%= successMessage[0] %>
            </div>
        <% } %>

        <% if (typeof errorMessage !== 'undefined' && errorMessage && errorMessage.length > 0) { %>
            <div class="alert alert-danger" role="alert">
                <%= errorMessage[0] %>
            </div>
        <% } %>

        <%# =========================
            Isaac - Personal Best
            ========================= %>

        <%# Personal best %>

        <% if (typeof pbNotification !== 'undefined' && pbNotification) { %>
            <% if (pbNotification.isNewPB) { %>
                <div id="pb-alert" class="alert alert-success alert-dismissible fade show mt-2" role="alert">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <strong>🎉 New Personal Best!</strong>
                            <div class="mt-2">
                                <div><strong><%= pbNotification.exerciseName %></strong> improved from <strong><%= pbNotification.oldPB %> kg</strong> to <strong><%= pbNotification.newPB %> kg</strong>.</div>
                                <div class="mt-1">
                                    <span>Improvement: <strong>+<%= pbNotification.improvementKg %> kg</strong></span>
                                    <% if (pbNotification.improvementPct != null) { %>
                                        <span> • <strong><%= pbNotification.improvementPct %>%</strong></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            <% } else if (pbNotification.isDemotion) { %>
                <div id="pb-alert" class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <div>
                            <strong>It's okay, we will get it next session</strong>
                            <div class="mt-2">
                                <div><strong><%= pbNotification.exerciseName %></strong> decreased from <strong><%= pbNotification.oldPB %> kg</strong> to <strong><%= pbNotification.newPB %> kg</strong>.</div>
                                <div class="mt-1">
                                    <span>Change: <strong><%= pbNotification.improvementKg %> kg</strong></span>
                                    <% if (pbNotification.improvementPct != null) { %>
                                        <span> • <strong><%= pbNotification.improvementPct %>%</strong></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            <% } %>
        <% } %>

        <%# =========================
            Isaac - Workout Statistics
            ========================= %>

        <%# Workout statistics %>

        <section class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 mb-1">Workout Statistics</h2>
                        <p class="text-muted mb-0">Your training summary at a glance.</p>
                    </div>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-4">
                    <div class="col">
                        <div class="card h-100 border-primary shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-muted mb-3">Total Workouts</h6>
                                <p class="display-6 mb-0 mt-auto"><%= stats.totalWorkouts %></p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-success shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-muted mb-3">Total Hours Trained</h6>
                                <p class="display-6 mb-0 mt-auto"><%= stats.totalHoursTrainedDisplay %></p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-warning shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-muted mb-3">Total Weight Lifted</h6>
                                <p class="display-6 mb-0 mt-auto"><%= stats.totalWeightLifted %> kg</p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-info shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-muted mb-3">Average Workout Duration</h6>
                                <p class="display-6 mb-0 mt-auto"><%= stats.averageWorkoutDurationDisplay %></p>
                            </div>
                        </div>
                    </div>

                    <div class="col">
                        <div class="card h-100 border-dark shadow-sm">
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-muted mb-3">Heaviest Lift</h6>
                                <p class="display-6 mb-0 mt-auto"><%= stats.heaviestLift %> kg</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <%# Personal best %>

        <section class="card mt-4 shadow-sm border-0" id="personal-best-card">
            <div class="card-header bg-dark text-white d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                <h5 class="mb-0">Personal Best</h5>
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text">Search</span>
                    <input
                        id="pbSearchInput"
                        type="text"
                        class="form-control"
                        placeholder="Exercise name"
                    >
                </div>
            </div>
            <div class="card-body">
                <% if (personalBest.length === 0 || !hasWorkoutData) { %>
                    <p class="mb-0 text-muted">No personal bests recorded yet. Add a workout to start tracking your progress.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="personalBestTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Exercise Name</th>
                                    <th class="text-end">Best Weight</th>
                                    <th class="text-end">Date Achieved</th>
                                </tr>
                            </thead>
                            <tbody id="personalBestTableBody">
                                <% personalBest.forEach(entry => { %>
                                    <tr
                                            data-exercise-name="<%= entry.exercise_name %>"
                                            class="<%= pbNotification && pbNotification.exerciseName === entry.exercise_name ? (pbNotification.isNewPB ? 'table-success fw-semibold' : (pbNotification.isDemotion ? 'table-danger fw-semibold' : '')) : '' %>"
                                        >
                                        <td><strong><%= entry.exercise_name %></strong></td>
                                        <td class="text-end"><%= entry.best_weight %> kg</td>
                                        <td class="text-end"><%= new Date(entry.date_achieved).toLocaleDateString() %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </section>

        <%# =========================
            Workout Statistics - END
            ========================= %>

        <%# =========================
            Personal Best - END
            ========================= %>

        <% if (!hasWorkoutData) { %>
            <div class="alert alert-info mt-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3" role="alert">
                <div>
                    <strong>No workouts recorded yet.</strong>
                    <div class="mt-1">Start by adding your first workout to build your history and personal bests.</div>
                </div>
                <a href="/addWorkout" class="btn btn-primary">Add Workout</a>
            </div>
        <% } else { %>
            <section class="card mt-4 shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2">
                    <h5 class="mb-0">Workout History</h5>
                    <div class="input-group input-group-sm" style="max-width: 280px;">
                        <span class="input-group-text">Search</span>
                        <input
                            id="workoutHistorySearchInput"
                            type="text"
                            class="form-control"
                            placeholder="Exercise name"
                        >
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="workoutHistoryTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Exercise</th>
                                    <th class="text-center">Sets</th>
                                    <th class="text-center">Reps</th>
                                    <th class="text-end">Weight</th>
                                    <th class="text-center">Duration</th>
                                    <th class="text-center">Date</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="workoutHistoryTableBody">
                                <% workouts.forEach(workout => { %>
                                    <tr
                                        data-exercise="<%= workout.exercise_name %>"
                                        data-date="<%= workout.workout_date %>"
                                        data-weight="<%= workout.weight %>"
                                    >
                                        <td class="fw-semibold">
                                            <%= workout.exercise_name %>
                                        </td>
                                        <td class="text-center">
                                            <%= workout.sets %>
                                        </td>
                                        <td class="text-center">
                                            <%= workout.repetitions %>
                                        </td>
                                        <td class="text-end">
                                            <%= workout.weight %> kg
                                        </td>
                                        <td class="text-center">
                                            <%= workout.duration %> min
                                        </td>
                                        <td class="text-center">
                                            <%= new Date(workout.workout_date).toLocaleDateString() %>
                                        </td>
                                        <td>
                                            <div class="d-flex justify-content-center gap-2">
                                                <a
                                                    href="/editWorkout/<%= workout.workout_id %>"
                                                    class="btn btn-warning btn-sm px-3"
                                                >
                                                    Edit
                                                </a>

                                                <form
                                                    action="/deleteWorkout/<%= workout.workout_id %>"
                                                    method="POST"
                                                    class="delete-workout-form d-inline"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="btn btn-danger btn-sm px-3"
                                                    >
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        <% } %>

    </main>

    <div class="modal fade" id="deleteWorkoutModal" tabindex="-1" aria-labelledby="deleteWorkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteWorkoutModalLabel">Delete workout?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    This action will permanently remove the workout from your history.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="confirmDeleteWorkoutBtn">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/personalBest.js"></script>
</body>

</html>